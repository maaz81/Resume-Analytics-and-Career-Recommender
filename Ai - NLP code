"""
AI + NLP Career Intelligence Engine
Performs:
- Skill extraction
- Skill gap analysis
- ATS scoring
- Job match scoring
- Course recommendation
- Project recommendation
- Learning path generation
"""

import spacy

# Load NLP model
nlp = spacy.load("en_core_web_sm")

# -----------------------------
# Skill Knowledge Base
# -----------------------------
SKILL_DB = [
    "python", "machine learning", "nlp", "sql",
    "react", "fastapi", "data analysis", "deep learning",
    "django", "java", "c++", "javascript"
]

COURSES = {
    "python": ["Python Basics", "Advanced Python"],
    "machine learning": ["ML by Andrew Ng"],
    "nlp": ["NLP with Python"],
    "sql": ["SQL Bootcamp"],
    "react": ["React Fundamentals"],
    "fastapi": ["FastAPI Masterclass"],
    "data analysis": ["Data Analysis with Pandas"],
    "deep learning": ["Deep Learning Specialization"]
}

PROJECTS = {
    "python": ["Student Management System"],
    "machine learning": ["House Price Prediction"],
    "nlp": ["Resume Parser"],
    "sql": ["Inventory System"],
    "react": ["Career Dashboard"],
    "fastapi": ["Job Portal API"],
    "data analysis": ["Sales Data Dashboard"],
    "deep learning": ["Image Classifier"]
}

# -----------------------------
# 1. Skill Extraction (NLP)
# -----------------------------
def extract_skills(text):
    """
    Extract skills from resume or JD using NLP
    """
    text = text.lower()
    doc = nlp(text)
    found_skills = []

    for skill in SKILL_DB:
        if skill in doc.text:
            found_skills.append(skill)

    return list(set(found_skills))


# -----------------------------
# 2. Skill Gap Analysis
# -----------------------------
def skill_gap(jd_skills, resume_skills):
    return list(set(jd_skills) - set(resume_skills))


# -----------------------------
# 3. Job Match Score
# -----------------------------
def job_match_score(jd_skills, resume_skills):
    if not jd_skills:
        return 0
    matched = set(jd_skills) & set(resume_skills)
    return round((len(matched) / len(jd_skills)) * 100, 2)


# -----------------------------
# 4. ATS Score
# -----------------------------
def ats_score(resume_text):
    keywords = ["skills", "experience", "projects", "education"]
    score = 0

    for word in keywords:
        if word in resume_text.lower():
            score += 25

    return score


# -----------------------------
# 5. Career Readiness Score
# -----------------------------
def career_readiness(job_match, ats):
    return round((job_match + ats) / 2, 2)


# -----------------------------
# 6. Course Recommendation
# -----------------------------
def recommend_courses(missing_skills):
    courses = []
    for skill in missing_skills:
        courses.extend(COURSES.get(skill, []))
    return list(set(courses))


# -----------------------------
# 7. Project Recommendation
# -----------------------------
def recommend_projects(missing_skills):
    projects = []
    for skill in missing_skills:
        projects.extend(PROJECTS.get(skill, []))
    return list(set(projects))


# -----------------------------
# 8. Learning Path Generator
# -----------------------------
def learning_path(missing_skills):
    plan = []
    for i, skill in enumerate(missing_skills):
        plan.append(f"Week {i+1}: Learn {skill}")
    return plan


# -----------------------------
# MAIN AI PIPELINE
# -----------------------------
def analyze_resume(resume_text, job_description):
    resume_skills = extract_skills(resume_text)
    jd_skills = extract_skills(job_description)

    missing_skills = skill_gap(jd_skills, resume_skills)
    match = job_match_score(jd_skills, resume_skills)
    ats = ats_score(resume_text)
    career = career_readiness(match, ats)

    return {
        "resume_skills": resume_skills,
        "job_required_skills": jd_skills,
        "missing_skills": missing_skills,
        "job_match_score": match,
        "ats_score": ats,
        "career_readiness_score": career,
        "recommended_courses": recommend_courses(missing_skills),
        "recommended_projects": recommend_projects(missing_skills),
        "learning_path": learning_path(missing_skills)
    }


# -----------------------------
# TEST RUN
# -----------------------------
if __name__ == "__main__":
    resume = """
    I have experience in Python, SQL and data analysis.
    Worked on machine learning project.
    """

    job_desc = """
    We need a candidate with Python, Machine Learning, NLP, FastAPI and SQL skills.
    """

    result = analyze_resume(resume, job_desc)

    for k, v in result.items():
        print(f"{k}: {v}")
